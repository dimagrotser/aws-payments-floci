# Fake credentials: Floci accepts anything, nothing here is a real secret.
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_DEFAULT_REGION=us-east-1
AWS_REGION=us-east-1

# Floci endpoint as seen from the host (aws cli, pytest, playwright).
# Containers on the compose network use http://floci:4566 instead.
AWS_ENDPOINT_URL=http://localhost:4566

PROJECT_NAME=payments
